# Storage Directories (Relative to backend/ or absolute)
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=2147483648 # 2 GB

# Video Processing Binaries
FFMPEG_PATH="C:\\Users\\BILAL.COM\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\ffmpeg-9.0.2-full_build\\bin\\ffmpeg.exe"
