# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database & Queue
# For PostgreSQL via Docker Compose: postgresql://postgres:postgres@localhost:5432/novacut?schema=public
